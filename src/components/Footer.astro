  {
    name: "GitHub",
    ariaLabel: "Visit our GitHub profile",
    href: "https://github.com/Amine-Triki",
    path: "M12 .5C5.648.5.5 5.648.5 12c0 5.086 3.292 9.387 7.865 10.912.575.1.785-.25.785-.556 0-.275-.01-1.002-.015-1.966-3.2.695-3.875-1.543-3.875-1.543-.523-1.328-1.278-1.682-1.278-1.682-1.044-.714.08-.7.08-.7 1.155.08 1.763 1.187 1.763 1.187 1.027 1.76 2.693 1.252 3.35.957.103-.744.402-1.253.732-1.542-2.553-.29-5.236-1.278-5.236-5.683 0-1.255.448-2.28 1.184-3.085-.118-.29-.513-1.457.112-3.037 0 0 .967-.31 3.168 1.18a11.02 11.02 0 0 1 2.883-.388c.977.005 1.963.132 2.883.388 2.2-1.49 3.165-1.18 3.165-1.18.627 1.58.233 2.747.115 3.037.74.805 1.18 1.83 1.18 3.085 0 4.415-2.687 5.39-5.253 5.673.41.355.79 1.07.79 2.157 0 1.557-.015 2.81-.015 3.19 0 .31.207.662.79.55C20.213 21.383 23.5 17.083 23.5 12c0-6.352-5.148-11.5-11.5-11.5z",
  },
  {
    name: "LinkedIn",
    ariaLabel: "Visit our LinkedIn profile",
    href: "https://www.linkedin.com/in/amine-triki-tn/",
    path: "M4.98 3.5a2.5 2.5 0 1 1 0 5.001 2.5 2.5 0 0 1 0-5.001zM3 9h4v12H3zM14.5 9c-2.33 0-3.5 1.42-3.5 3.24V21h4v-7.17c0-.74.28-1.83 1.67-1.83 1.35 0 1.33 1.17 1.33 1.89V21h4v-7.59c0-3.31-1.78-4.84-4.3-4.84z",
  },
];
---

<footer
  class="footer sm:footer-horizontal bg-neutral text-neutral-content items-center p-4 mt-12"
  role="contentinfo"
>
  <aside class="grid-flow-col items-center">
    <p>
      Copyright © {currentYear} - All rights reserved | 
      <a 
        href="/" 
        class="link link-hover"
        title="Go to homepage"
      >
        Amine Triki
      </a>
    </p>
  </aside>

  <nav 
    class="grid-flow-col gap-4 md:place-self-center md:justify-self-end"
    aria-label="Social media links"
  >
    {
      socialLinks.map((link) => (
        <a
          href={link.href}
          title={link.name}
          aria-label={link.ariaLabel}
          rel="noopener noreferrer"
          target="_blank"
          class="transition-colors duration-300 hover:opacity-80 focus:outline-none rounded-md p-1"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            class="fill-current transition-transform duration-300 hover:scale-110"
            aria-hidden="true"
          >
            <path d={link.path} />
          </svg>
        </a>
      ))
    }
  </nav>
</footer>

<style>
  footer {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
</style>