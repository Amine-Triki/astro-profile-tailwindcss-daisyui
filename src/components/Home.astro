---
import Icon from "../components/Icons.astro";
import { Image } from "astro:assets";
import aminImage from "../assets/amine-triki.webp";

const res = await fetch(
  "https://raw.githubusercontent.com/Amine-Triki/projects-data/main/cv.json",
);
const cvData = await res.json();
---

<main class="min-h-screen flex items-center">
  <div
    class="container mx-auto my-5 flex flex-wrap flex-row items-center justify-center gap-8"
  >
    <!-- النص والمحتوى -->
    <div class="flex-1 min-w-80 p-4">
      <p class="text-lg text-gray-600">Hello, I am</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Amine Triki</h1>

      <p class="text-xl text-gray-700 mb-2">Junior Full-Stack Developer</p>

      <!-- ✨ النص الذي فيه التأثير -->
      <p class="text-2xl font-semibold mt-4 flex items-center gap-2 mb-6">
        <span>And I'm a</span>
        <span
          id="typed"
          class="text-purple-700 cursor opacity-0 translate-y-2 transition-all duration-300"
        ></span>
      </p>

      <p class="max-w-96 mt-3 text-gray-700 leading-relaxed">
        Based in Tunisia, I’m a Full-Stack Developer and creative content
        creator. I turn ideas into websites that are fast, modern, and very easy
        to use — helping businesses grow online. Whether you need a custom web
        application or a WordPress site, I focus on clean design and ensure
        everything works perfectly on phones, tablets, and computers (Responsive
        Design). Beyond coding, I share my development journey and insights on
        YouTube to help others learn.
      </p>

      <!-- أزرار السيرة الذاتية -->
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          target="_blank"
          rel="noopener noreferrer"
          href={cvData.cv.en.download}
          class="inline-flex items-center justify-center px-8 py-3 font-semibold text-white bg-purple-700 rounded-lg shadow-md hover:bg-purple-800 hover:shadow-xl transform hover:scale-105 transition duration-300 ease-in-out focus:outline-none focus:ring-2 focus:ring-offset-2"
          aria-label="Download my resume in PDF format"
          title="Download Resume"
        >
          📥 Download Resume
        </a>
        <a
          href={cvData.cv.en.preview}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-8 py-3 font-semibold text-purple-700 bg-purple-100 border border-purple-200 rounded-lg shadow-sm hover:bg-purple-200 hover:border-purple-300 transition duration-300 ease-in-out focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-400"
          aria-label="Preview my resume online"
          title="Preview Resume"
        >
          👁️ Preview
        </a>
      </div>
      <!-- Social Icons -->
      <div class="mt-8">
        <Icon />
      </div>
    </div>

    <!-- الصورة -->
    <div class="flex-1 min-w-80 p-4 flex justify-center lg:justify-end">
      <Image
        src={aminImage}
        alt="Amine Triki - Junior full stack Developer from Tunisia"
        width={570}
        height={662}
        priority
        fetchpriority="high"
        sizes="(max-width: 640px) 90vw, (max-width: 1024px) 50vw, 400px"
        class="w-full max-w-sm rounded-lg shadow-lg"
      />
    </div>
  </div>
</main>

<!-- سكربت يعمل في المتصفح فقط -->
<script>
  const words = ["Youtuber", "Blogger", "Freelancer", "Developer"];
  const el = document.getElementById("typed");
  let wordIndex = 0;
  let charIndex = 0;
  let isDeleting = false;

  function type() {
    if (!el) return;
    const currentWord = words[wordIndex];

    // تأثير الظهور (fade + slide)
    if (!isDeleting && charIndex === 1) {
      el.classList.remove("opacity-0", "translate-y-2");
      el.classList.add("opacity-100", "translate-y-0");
    }

    if (isDeleting && charIndex === currentWord.length - 1) {
      el.classList.add("opacity-0", "translate-y-2");
    }

    // الكتابة
    if (isDeleting) {
      charIndex--;
      el.textContent = currentWord.substring(0, charIndex);
    } else {
      charIndex++;
      el.textContent = currentWord.substring(0, charIndex);
    }

    let delay = isDeleting ? 40 : 80;

    if (!isDeleting && charIndex === currentWord.length) {
      delay = 1000;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      wordIndex = (wordIndex + 1) % words.length;
      delay = 300;
    }

    setTimeout(type, delay);
  }

  type();
</script>

<style>
  .cursor::after {
    content: "|";
    animation: blink 1s step-start infinite;
    margin-left: 2px;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
  }

  /* Focus visible للوصول الأفضل */
  a:focus-visible {
    outline: none;
  }
</style>
