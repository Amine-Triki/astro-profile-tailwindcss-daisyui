---
import Icon from "./Icons.astro";
import { Image } from "astro:assets";
import aminImage from "../assets/amine-triki.webp";
import { displayNames, roles, type Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const displayName = displayNames[lang];
const localizedRoles = roles[lang];
const cv = {
  en: { download: "/cv-en.pdf", preview: "/cv-en.pdf" },
  fr: { download: "/cv-fr.pdf", preview: "/cv-fr.pdf" },
  ar: { download: "/cv-ar.pdf", preview: "/cv-ar.pdf" },
}[lang];
---
<main class="min-h-screen flex items-center" data-roles={JSON.stringify(localizedRoles)}><div class="container mx-auto my-5 flex flex-wrap flex-row items-center justify-center gap-8">
  <div class="flex-1 min-w-80 p-4"><p class="text-lg my-4 text-gray-700 dark:text-gray-300">{t("home.hello")}</p><h1 class="text-4xl md:text-5xl font-bold mb-4">{displayName}</h1><p class="text-xl text-gray-900 dark:text-gray-200 mb-2">{t("home.role")}</p><p class="text-2xl font-semibold mt-4 flex items-center gap-2 mb-6"><span>{t("home.and")}</span><span id="typed" class="text-purple-800 dark:text-purple-300 cursor opacity-0 translate-y-2 transition-all duration-300"></span></p><p class="max-w-96 mt-3 text-gray-800 dark:text-gray-300 leading-relaxed">{t("home.description")}</p>
    <div class="mt-8 flex flex-wrap items-center gap-3.5"><a href={cv.download} download class="inline-flex items-center justify-center px-8 py-3 font-semibold text-white bg-purple-700 rounded-lg shadow-md hover:bg-purple-800 dark:bg-purple-600 dark:hover:bg-purple-500 transition" aria-label={t("home.resume.downloadAria")}>{t("home.resume.download")}</a><a href={cv.preview} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-3 font-semibold text-purple-800 bg-purple-100 border border-purple-300 hover:bg-purple-200 dark:text-purple-200 dark:bg-purple-900/50 dark:border-purple-700 dark:hover:bg-purple-800/70 rounded-lg transition" aria-label={t("home.resume.previewAria")}>{t("home.resume.preview")}</a></div><Icon />
  </div><div class="flex-1 min-w-80 p-4 flex justify-center lg:justify-end"><Image src={aminImage} alt={t("home.imageAlt")} width={570} height={662} priority fetchpriority="high" sizes="(max-width: 640px) 90vw, (max-width: 1024px) 50vw, 400px" class="w-full max-w-sm rounded-lg shadow-lg" /></div>
</div></main>
<script>
  const words = JSON.parse(document.querySelector("main[data-roles]")?.getAttribute("data-roles") ?? "[]") as string[];
  const el = document.getElementById("typed");
  let wordIndex = 0;
  let charIndex = 0;
  let isDeleting = false;

  function type() {
    if (!el) return;
    const currentWord = words[wordIndex];

    if (!isDeleting && charIndex === 1) {
      el.classList.remove("opacity-0", "translate-y-2");
      el.classList.add("opacity-100", "translate-y-0");
    }

    if (isDeleting && charIndex === currentWord.length - 1) {
      el.classList.add("opacity-0", "translate-y-2");
    }

    if (isDeleting) {
      charIndex--;
      el.textContent = currentWord.substring(0, charIndex);
    } else {
      charIndex++;
      el.textContent = currentWord.substring(0, charIndex);
    }

    let delay = isDeleting ? 40 : 80;

    if (!isDeleting && charIndex === currentWord.length) {
      delay = 1000;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      wordIndex = (wordIndex + 1) % words.length;
      delay = 300;
    }

    setTimeout(type, delay);
  }

  type();
</script>
<style>
  .cursor::after {
    content: "|";
    animation: blink 1s step-start infinite;
    margin-inline-start: 2px;
  }

  @keyframes blink {
    0%, 100% { opacity: 0; }
    50% { opacity: 1; }
  }
</style>
