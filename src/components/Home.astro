<div class="container mx-auto my-5 flex flex-wrap flex-row items-center justify-center">
  <div class="p-4">
    <p>Hello ; I am</p>
    <h2 class="text-2xl font-bold">Amine Triki</h2>

    <p>I am Junior front end developer</p>

    <!-- ✨ النص الذي فيه التأثير -->
    <p class="text-xl font-semibold mt-2 flex items-center gap-2">
      And I’m a 
      <span 
        id="typed" 
        class="text-blue-600 cursor opacity-0 translate-y-2 transition-all duration-300"
      ></span>
    </p>

    <p class="max-w-96 mt-3">
      based in tunisia; I create elegant and responsive sites, easy to use and
      built with best practices. I use HTML ,CSS, JavaScript (React); 
      I am a WordPress designer.
    </p>
  </div>

  <div class="w-1/2 md:w-1/3 p-4">
    <img src="/amine triki.webp" alt="amine triki" />
  </div>
</div>

<!-- سكربت يعمل في المتصفح فقط -->
<script >

  const words = ['youtuber', 'blogger', 'freelancer', 'developer'];
  const el = document.getElementById('typed');
  let wordIndex = 0;
  let charIndex = 0;
  let isDeleting = false;

  function type() {
    if (!el) return;
    const currentWord = words[wordIndex];

    // تأثير الظهور (fade + slide)
    if (!isDeleting && charIndex === 1) {
      el.classList.remove("opacity-0", "translate-y-2");
      el.classList.add("opacity-100", "translate-y-0");
    }

    if (isDeleting && charIndex === currentWord.length - 1) {
      el.classList.add("opacity-0", "translate-y-2");
    }

    // الكتابة
    if (isDeleting) {
      charIndex--;
      el.textContent = currentWord.substring(0, charIndex);
    } else {
      charIndex++;
      el.textContent = currentWord.substring(0, charIndex);
    }

    let delay = isDeleting ? 40 : 80;

    if (!isDeleting && charIndex === currentWord.length) {
      delay = 1000;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      wordIndex = (wordIndex + 1) % words.length;
      delay = 300;
    }

    setTimeout(type, delay);
  }

  type();
</script>

<style>
  .cursor::after {
    content: '|';
    animation: blink 1s step-start infinite;
    margin-left: 2px;
  }

  @keyframes blink {
    0%, 100% { opacity: 0; }
    50% { opacity: 1; }
  }
</style>
