---
// Navbar.astro
const currentPath = Astro.url.pathname;
---

<div class="navbar bg-base-100 shadow-lg sticky top-0 z-50">
  <!-- Logo والاسم -->
  <div class="navbar-start">
    <!-- زر القائمة للهاتف -->
    <div class="dropdown">
      <label tabindex="0" class="btn btn-ghost lg:hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
        </svg>
      </label>
      <!-- القائمة المنسدلة للهاتف -->
      <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-1 p-2 shadow bg-base-100 rounded-box w-52">
        <li><a href="/" class={currentPath === '/' ? 'active' : ''}>Home</a></li>
        <li><a href="/projects" class={currentPath === '/projects' ? 'active' : ''}>Projects</a></li>
        <li><a href="/contact" class={currentPath === '/contact' ? 'active' : ''}>Contact</a></li>
      </ul>
    </div>
    
    <!-- الشعار والاسم -->
    <a href="/" class="btn btn-ghost normal-case text-xl gap-2">
      <!-- شعار SVG - يمكنك تغييره بشعارك -->
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      <span class="hidden sm:inline">My Website</span>
      <span class="inline sm:hidden">MW</span>
    </a>
  </div>
  
  <!-- القائمة للشاشات الكبيرة -->
  <div class="navbar-center hidden lg:flex">
    <ul class="menu menu-horizontal px-1 gap-2">
      <li>
        <a href="/" class={`btn btn-ghost ${currentPath === '/' ? 'btn-active' : ''}`}>
          Home
        </a>
      </li>
      <li>
        <a href="/projects" class={`btn btn-ghost ${currentPath === '/projects' ? 'btn-active' : ''}`}>
          Projects
        </a>
      </li>
      <li>
        <a href="/contact" class={`btn btn-ghost ${currentPath === '/contact' ? 'btn-active' : ''}`}>
          Contact
        </a>
      </li>
    </ul>
  </div>
  
  <!-- زر إضافي (مثل Theme Toggle أو Profile) -->
  <div class="navbar-end gap-2">
    <!-- زر تبديل الثيم -->
    <label class="swap swap-rotate btn btn-ghost btn-circle">
      <input type="checkbox" class="theme-controller" value="dark" />
      <!-- أيقونة الشمس -->
      <svg class="swap-on fill-current w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"/>
      </svg>
      <!-- أيقونة القمر -->
      <svg class="swap-off fill-current w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"/>
      </svg>
    </label>
  </div>
</div>

<script>
  /**
   * نظام تبديل الثيم (Dark/Light Mode)
   * يستخدم localStorage لحفظ تفضيلات المستخدم
   */
  
  // 1. البحث عن زر التبديل (checkbox) وتحديد نوعه بشكل صحيح
  const toggle = document.querySelector('.theme-controller') as HTMLInputElement | null;
  
  // 2. التحقق من وجود الزر قبل العمل عليه (معالجة null)
  if (toggle) {
    // 3. تحميل الثيم المحفوظ من localStorage أو استخدام 'light' كقيمة افتراضية
    const currentTheme = localStorage.getItem('theme') || 'light';
    
    // 4. تطبيق الثيم على عنصر HTML الرئيسي
    document.documentElement.setAttribute('data-theme', currentTheme);
    
    // 5. ضبط حالة الـ checkbox بناءً على الثيم المحفوظ
    if (currentTheme === 'dark') {
      toggle.checked = true;
    }
    
    // 6. إضافة مستمع للأحداث عند تغيير الـ checkbox
    toggle.addEventListener('change', (e: Event) => {
      // 7. تحديد نوع الـ target بشكل صحيح (HTMLInputElement)
      const target = e.target as HTMLInputElement;
      
      // 8. تحديد الثيم الجديد بناءً على حالة الـ checkbox
      const theme = target.checked ? 'dark' : 'light';
      
      // 9. تطبيق الثيم الجديد على الصفحة
      document.documentElement.setAttribute('data-theme', theme);
      
      // 10. حفظ الثيم في localStorage للاستخدام في الزيارات القادمة
      localStorage.setItem('theme', theme);
    });
  }
</script>

<style>
  /* تأثيرات إضافية */
  .navbar {
    backdrop-filter: blur(10px);
  }
  
  .btn-active {
    background-color: hsl(var(--p) / 0.2);
  }
  
  @media (max-width: 640px) {
    .navbar {
      padding: 0.5rem;
    }
  }
</style>