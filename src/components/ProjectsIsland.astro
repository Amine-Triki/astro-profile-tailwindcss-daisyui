---
import Heading from "../components/Heading.astro";
import { type Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
const { lang = "en" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);

interface ProjectVariant {
  stack: string;
  link: string;
  github?: string;
}

interface Project {
  category: "Website" | "Web App" | "Tool" | "Mobile App";
  title: string | Record<string, string>;
  description: string | Record<string, string>;
  technologies?: string[];
  featured: boolean;
  link?: string;
  github?: string;
  imageSrc: string;
  variants?: ProjectVariant[];
  screenshots?: string[];
}

const projectsDataUrl =
  import.meta.env.PROJECTS_DATA_URL ??
  "https://raw.githubusercontent.com/Amine-Triki/projects-data/main/projects.json";
const allowedCategories = new Set<Project["category"]>([
  "Website",
  "Web App",
  "Tool",
  "Mobile App",
]);
const httpUrl = /^https?:\/\//i;

function isValidUrl(value: unknown): value is string {
  return typeof value === "string" && httpUrl.test(value);
}

function validateProject(project: unknown, index: number): Project {
  if (!project || typeof project !== "object") {
    throw new Error(`Project ${index + 1} is not an object.`);
  }

  const candidate = project as Partial<Project>;
  if (
    !((typeof candidate.title === "string" && candidate.title.length > 0) || (candidate.title && typeof candidate.title === "object")) ||
    !((typeof candidate.description === "string" && candidate.description.length > 0) || (candidate.description && typeof candidate.description === "object")) ||
    typeof candidate.imageSrc !== "string" ||
    !allowedCategories.has(candidate.category as Project["category"]) ||
    typeof candidate.featured !== "boolean" ||
    !isValidUrl(candidate.imageSrc)
  ) {
    throw new Error(`Project ${index + 1} has invalid required fields.`);
  }

  for (const url of [candidate.link, candidate.github]) {
    if (url && !isValidUrl(url)) {
      throw new Error(`Project "${candidate.title}" contains an invalid link.`);
    }
  }

  for (const variant of candidate.variants ?? []) {
    if (
      typeof variant.stack !== "string" ||
      !isValidUrl(variant.link) ||
      (variant.github && !isValidUrl(variant.github))
    ) {
      throw new Error(`Project "${candidate.title}" contains an invalid variant.`);
    }
  }

  for (const screenshot of candidate.screenshots ?? []) {
    if (!isValidUrl(screenshot)) {
      throw new Error(`Project "${candidate.title}" contains an invalid screenshot URL.`);
    }
  }

  return candidate as Project;
}

let projects: Project[];
try {
  const response = await fetch(projectsDataUrl);
  if (!response.ok) {
    throw new Error(`The project data request returned HTTP ${response.status}.`);
  }

  const data: unknown = await response.json();
  if (!Array.isArray(data) || data.length === 0) {
    throw new Error("The project data must be a non-empty JSON array.");
  }
  projects = data.map(validateProject);
} catch (error) {
  const reason = error instanceof Error ? error.message : "Unknown data error.";
  throw new Error(`Unable to build the projects page from ${projectsDataUrl}: ${reason}`);
}

const featuredProjects = projects.filter((project) => project.featured);
const otherProjects = projects.filter((project) => !project.featured);
const categories = ["all", ...new Set(otherProjects.map((project) => project.category))];
function localized(value: string | Record<string, string>) {
  return typeof value === "string" ? value : value[lang] ?? value.en ?? Object.values(value)[0] ?? "";
}
---

<div class="py-10 container mx-auto">
  <Heading title={t("projects.title")} subTitle={t("projects.subtitle")} />

  <section aria-labelledby="featured-projects-title" class="mb-12">
    <h2 id="featured-projects-title" class="mb-6 text-2xl font-bold text-primary">{t("projects.featured")}</h2>
    <div class="grid gap-6 justify-center grid-cols-[repeat(auto-fill,minmax(300px,1fr))]">
      {featuredProjects.map((project) => (
        <article class="card bg-base-100 shadow-lg">
          <figure>
            <img src={project.imageSrc} alt={`${localized(project.title)} ${t("projects.projectAlt")}`} class="h-56 w-full object-cover" loading="lazy" width="800" height="450" />
          </figure>
          <div class="card-body">
            <div class="flex items-start justify-between gap-3">
              <h3 class="card-title text-primary">{localized(project.title)}</h3>
              <span class="badge badge-outline shrink-0">{project.category}</span>
            </div>
            <p class="leading-relaxed">{localized(project.description)}</p>
            <div class="flex flex-wrap gap-2">
              {project.technologies?.map((technology) => <span class="badge badge-ghost badge-sm">{technology}</span>)}
            </div>
            <div class="card-actions justify-center gap-2 mt-2">
              {project.variants ? project.variants.map((variant) => (
                <div class="flex items-center gap-1">
                  <a href={variant.link} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline">{variant.stack}</a>
                  {variant.github && <a href={variant.github} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-square btn-error text-black" aria-label={`${variant.stack} GitHub`} title={`${variant.stack} GitHub`}>
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.49.5.09.68-.22.68-.48 0-.24-.01-.87-.01-1.7-2.78.6-3.37-1.34-3.37-1.34-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 8.18c.85 0 1.71.12 2.51.37 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85 0 1.34-.01 2.42-.01 2.75 0 .27.18.58.69.48A10.01 10.01 0 0 0 22 12C22 6.48 17.52 2 12 2Z" /></svg>
                  </a>}
                </div>
              )) : (
                <>
                  {project.link && <a href={project.link} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-info text-white">{t("projects.live")}</a>}
                  {project.github && <a href={project.github} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-error text-black">{t("projects.github")}</a>}
                  {project.screenshots?.length && (
                    <button type="button" data-screenshot-project={projects.indexOf(project)} data-project-title={localized(project.title)} data-screenshots={JSON.stringify(project.screenshots)} class="screenshot-btn btn btn-sm btn-outline">{t("projects.screenshots")}</button>
                  )}
                </>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section aria-labelledby="all-projects-title">
    <h2 id="all-projects-title" class="mb-6 text-2xl font-bold text-primary">{t("projects.other")}</h2>
    <div id="category-tabs" class="flex flex-wrap justify-center mb-8 gap-2" role="group" aria-label={t("projects.filter")}>
      {categories.map((category, index) => (
        <button type="button" class:list={["tab-btn btn btn-sm btn-outline", { "btn-primary": index === 0 }]} data-category={category}>
          {category === "all" ? t("projects.all") : category}
        </button>
      ))}
    </div>

    <div id="projects-grid" class="grid gap-6 justify-center grid-cols-[repeat(auto-fill,minmax(280px,1fr))]">
      {otherProjects.map((project) => (
        <article class="card bg-base-100 shadow-lg" data-project-category={project.category}>
          <figure>
            <img src={project.imageSrc} alt={`${localized(project.title)} ${t("projects.projectAlt")}`} class="h-40 w-full object-cover" loading="lazy" width="800" height="450" />
          </figure>
          <div class="card-body">
            <div class="flex items-start justify-between gap-3">
              <h3 class="card-title text-primary">{localized(project.title)}</h3>
              <span class="badge badge-outline shrink-0">{project.category}</span>
            </div>
            <p>{localized(project.description)}</p>
            <div class="flex flex-wrap gap-2">
              {project.technologies?.map((technology) => <span class="badge badge-ghost badge-sm">{technology}</span>)}
            </div>
            <div class="card-actions justify-center gap-2 mt-2">
              {project.variants ? project.variants.map((variant) => (
                <div class="flex items-center gap-1">
                  <a href={variant.link} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline">{variant.stack}</a>
                  {variant.github && <a href={variant.github} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-square btn-error text-black" aria-label={`${variant.stack} GitHub`} title={`${variant.stack} GitHub`}>
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.49.5.09.68-.22.68-.48 0-.24-.01-.87-.01-1.7-2.78.6-3.37-1.34-3.37-1.34-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 8.18c.85 0 1.71.12 2.51.37 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85 0 1.34-.01 2.42-.01 2.75 0 .27.18.58.69.48A10.01 10.01 0 0 0 22 12C22 6.48 17.52 2 12 2Z" /></svg>
                  </a>}
                </div>
              )) : (
                <>
                  {project.link && <a href={project.link} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-info text-white">{t("projects.live")}</a>}
                  {project.github && <a href={project.github} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-error text-black">{t("projects.github")}</a>}
                  {project.screenshots?.length && (
                    <button type="button" data-screenshot-project={projects.indexOf(project)} data-project-title={localized(project.title)} data-screenshots={JSON.stringify(project.screenshots)} class="screenshot-btn btn btn-sm btn-outline">{t("projects.screenshots")}</button>
                  )}
                </>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</div>

<dialog id="screenshots-modal" class="modal" aria-labelledby="screenshots-title">
  <div class="modal-box max-w-3xl">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" aria-label="Close screenshots">&times;</button>
    </form>
    <h2 id="screenshots-title" class="pr-8 text-xl font-bold"></h2>
    <img id="screenshot-main" class="mt-4 max-h-[60vh] w-full rounded-box object-contain" alt="" />
    <div id="screenshot-thumbnails" class="mt-4 flex gap-2 overflow-x-auto pb-2"></div>
  </div>
  <form method="dialog" class="modal-backdrop"><button aria-label="Close screenshots">close</button></form>
</dialog>

<script>
  const projectsGrid = document.getElementById("projects-grid");
  const categoryTabs = document.getElementById("category-tabs");
  const screenshotsModal = document.getElementById("screenshots-modal") as HTMLDialogElement | null;
  const screenshotsTitle = document.getElementById("screenshots-title");
  const screenshotMain = document.getElementById("screenshot-main") as HTMLImageElement | null;
  const screenshotThumbnails = document.getElementById("screenshot-thumbnails");

  function openScreenshots(button: HTMLButtonElement) {
    const screenshots = JSON.parse(button.dataset.screenshots ?? "[]") as string[];
    if (!screenshots.length || !screenshotsModal || !screenshotsTitle || !screenshotMain || !screenshotThumbnails) return;

    screenshotsTitle.textContent = `${button.dataset.projectTitle ?? "Project"} screenshots`;
    screenshotThumbnails.innerHTML = screenshots.map((screenshot, index) => `
      <button type="button" data-screenshot-index="${index}" class="screenshot-thumbnail shrink-0 rounded-box border-2 border-transparent p-1" aria-label="View screenshot ${index + 1}">
        <img src="${screenshot}" alt="" class="h-16 w-16 object-cover" loading="lazy" />
      </button>
    `).join("");

    const showScreenshot = (index: number) => {
      const screenshot = screenshots[index];
      if (!screenshot || !screenshotMain) return;
      screenshotMain.src = screenshot;
      screenshotMain.alt = `${button.dataset.projectTitle ?? "Project"} screenshot ${index + 1}`;
      screenshotThumbnails?.querySelectorAll(".screenshot-thumbnail").forEach((thumbnail, thumbnailIndex) => {
        thumbnail.classList.toggle("border-primary", thumbnailIndex === index);
      });
    };

    screenshotThumbnails.querySelectorAll<HTMLButtonElement>(".screenshot-thumbnail").forEach((thumbnail) => {
      thumbnail.addEventListener("click", () => showScreenshot(Number(thumbnail.dataset.screenshotIndex)));
    });
    showScreenshot(0);
    screenshotsModal.showModal();
  }

  categoryTabs?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".tab-btn");
    if (!button || !projectsGrid) return;
    const category = button.dataset.category ?? "all";
    projectsGrid.querySelectorAll<HTMLElement>("article").forEach((project) => {
      project.hidden = category !== "all" && project.dataset.projectCategory !== category;
    });
    categoryTabs.querySelectorAll(".tab-btn").forEach((tab) => tab.classList.remove("btn-primary"));
    button.classList.add("btn-primary");
  });

  projectsGrid?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".screenshot-btn");
    if (button) openScreenshots(button);
  });
</script>
