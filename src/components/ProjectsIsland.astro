---
import Heading from "../components/Heading.astro";
---

<div class="py-10 container mx-auto">
  <Heading title="My Projects" subTitle="What I build" />

  <!-- Tabs -->
  <div id="category-tabs" class="flex flex-wrap justify-center mb-8 space-x-2 space-y-3">
    <!-- Filled from the project categories in the JSON response. -->
  </div>

  <!-- Loading Spinner -->
  <div id="spinner" class="flex justify-center items-center min-h-[50vh]">
    <span class="loading loading-spinner text-primary"></span>
  </div>

  <!-- Projects Grid -->
  <div
    id="projects-grid"
    class="grid gap-6 justify-center
         grid-cols-[repeat(auto-fill,300px)]"
  >
    <!-- سيتم ملؤه بواسطة JS -->
  </div>
</div>


<script>
  type Project = {
    category: string;
    title: string;
    description: string;
    technologies: string[];
    link: string;
    github: string;
    imageSrc: string;
  };

  const spinner = document.getElementById("spinner");
  const grid = document.getElementById("projects-grid");
  const categoryTabs = document.getElementById("category-tabs");

  async function loadProjects() {
    try {
      const response = await fetch(
        "https://raw.githubusercontent.com/Amine-Triki/projects-data/main/projects.json",
      );
      if (!response.ok) {
        throw new Error(`Failed to fetch projects: ${response.status}`);
      }

      const projects = (await response.json()) as Project[];
      const categories = [
        "all",
        ...new Set(projects.map((project) => project.category)),
      ];

      if (!spinner || !grid || !categoryTabs) return;
      const projectsSpinner = spinner;
      const projectsGrid = grid;
      const projectsCategoryTabs = categoryTabs;

      projectsSpinner.style.display = "none";
      projectsCategoryTabs.innerHTML = categories
        .map(
          (category) => `
            <button class="tab-btn btn btn-sm btn-outline" data-category="${category}">
              ${category === "all" ? "All works" : category}
            </button>
          `,
        )
        .join("");

      function renderProjects(filter = "all") {
        projectsGrid.innerHTML = "";
        projects
          .filter((project) => filter === "all" || project.category === filter)
          .forEach((p) => {
            const card = document.createElement("div");
            card.className = "card bg-base-100 shadow-lg";
            card.innerHTML = `
              <figure>
                <img src="${p.imageSrc}" alt="${p.title}" class="h-40 w-full object-cover"/>
              </figure>
              <div class="card-body">
                <div class="flex items-start justify-between gap-3">
                  <h2 class="card-title text-primary">${p.title}</h2>
                  <span class="badge badge-outline shrink-0">${p.category}</span>
                </div>
                <p>${p.description}</p>
                <div class="flex flex-wrap gap-2">
                  ${p.technologies.map((technology) => `<span class="badge badge-ghost badge-sm">${technology}</span>`).join("")}
                </div>
                <div class="card-actions justify-around mt-2">
                  ${p.github ? `<a href="${p.github}" target="_blank" class="btn btn-sm btn-error text-black">Github</a>` : ""}
                  ${p.link ? `<a href="${p.link}" target="_blank" class="btn btn-sm btn-info text-white">Preview</a>` : ""}
                </div>
              </div>
            `;
              projectsGrid.appendChild(card);
          });
      }

      // عرض جميع المشاريع عند البداية
      renderProjects();

      // Add event listeners to the categories derived from the JSON data.
      document.querySelectorAll<HTMLButtonElement>(".tab-btn").forEach((btn) => {
        btn.addEventListener("click", (event) => {
          const clickedButton = event.currentTarget as HTMLButtonElement;
          const category = clickedButton.dataset.category ?? "all";
          renderProjects(category);

          document
            .querySelectorAll(".tab-btn")
            .forEach((b) => b.classList.remove("btn-primary"));
          clickedButton.classList.add("btn-primary");
        });
      });

      projectsCategoryTabs.querySelector<HTMLButtonElement>(".tab-btn")?.classList.add("btn-primary");
    } catch (error) {
      if (spinner) {
        spinner.innerHTML = `<p class="text-red-500">Failed to load projects</p>`;
      }
      console.error(error);
    }
  }

  loadProjects();
</script>
