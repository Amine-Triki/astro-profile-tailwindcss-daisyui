---
import Layout from "../layouts/Layout.astro";
import { type Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const files = {
  en: "/cv-en.pdf",
  fr: "/cv-fr.pdf",
  ar: "/cv-ar.pdf",
} as const;
---

<Layout lang={lang} title={t("resume.title")} robots="noindex">
  <main class="resume">
    <div class="toolbar">
      <div class="group" role="group" aria-label={t("resume.language")}>
        <button type="button" class="lang" data-file={files.en} data-lang="en">EN</button>
        <button type="button" class="lang" data-file={files.fr} data-lang="fr">FR</button>
        <button type="button" class="lang" data-file={files.ar} data-lang="ar">AR</button>
      </div>

      <div class="group" role="group" aria-label={t("resume.zoom")}>
        <button type="button" id="zoom-out" aria-label={t("resume.zoomOut")}>−</button>
        <span id="zoom-label" aria-live="polite">100%</span>
        <button type="button" id="zoom-in" aria-label={t("resume.zoomIn")}>+</button>
        <button type="button" id="zoom-fit">{t("resume.fit")}</button>
      </div>

      <a id="download" class="download" href={files[lang]} download>{t("resume.download")}</a>
    </div>

    <p id="status" role="status" data-loading={t("resume.loading")} data-error={t("resume.error")}>{t("resume.loading")}</p>
    <div id="viewer" class="viewer" dir="ltr"></div>
  </main>
</Layout>

<script>
  import * as pdfjsLib from 'pdfjs-dist';
  import workerSrc from 'pdfjs-dist/build/pdf.worker.min.mjs?url';

  pdfjsLib.GlobalWorkerOptions.workerSrc = workerSrc;

  const viewer = document.getElementById('viewer') as HTMLDivElement;
  const statusEl = document.getElementById('status') as HTMLParagraphElement;
  const loadingText = statusEl.dataset.loading!;
  const errorText = statusEl.dataset.error!;
  const defaultLang = document.documentElement.lang.slice(0, 2).toLowerCase();
  const zoomLabel = document.getElementById('zoom-label') as HTMLSpanElement;
  const downloadLink = document.getElementById('download') as HTMLAnchorElement;
  const langButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.lang'));

  const MIN_ZOOM = 0.6;
  const MAX_ZOOM = 3;
  const STEP = 0.2;

  let pdfDoc: any = null;
  let loadingTask: { destroy: () => Promise<void> } | null = null;
  let zoom = 1;
  let renderId = 0;
  let lastWidth = 0;
  let timer: number | undefined;

  function setStatus(text: string) {
    statusEl.textContent = text;
    statusEl.hidden = text === '';
  }

  async function renderAll() {
    if (!pdfDoc) return;
    const id = ++renderId;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const fitWidth = viewer.clientWidth;
    lastWidth = fitWidth;
    viewer.replaceChildren();

    for (let n = 1; n <= pdfDoc.numPages; n++) {
      const page = await pdfDoc.getPage(n);
      if (id !== renderId) return;

      const base = page.getViewport({ scale: 1 });
      const viewport = page.getViewport({ scale: (fitWidth / base.width) * zoom });

      const canvas = document.createElement('canvas');
      canvas.width = Math.floor(viewport.width * dpr);
      canvas.height = Math.floor(viewport.height * dpr);
      canvas.style.width = `${Math.floor(viewport.width)}px`;
      canvas.style.height = `${Math.floor(viewport.height)}px`;
      viewer.appendChild(canvas);

      const context = canvas.getContext('2d')!;
      context.direction = 'ltr';
      await page.render({
        canvasContext: context,
        viewport,
        transform: dpr !== 1 ? [dpr, 0, 0, dpr, 0, 0] : undefined,
      }).promise;
      if (id !== renderId) return;
    }
    zoomLabel.textContent = `${Math.round(zoom * 100)}%`;
  }

  function scheduleRender() {
    zoomLabel.textContent = `${Math.round(zoom * 100)}%`;
    window.clearTimeout(timer);
    timer = window.setTimeout(renderAll, 150);
  }

  async function load(file: string, lang: string) {
    langButtons.forEach((b) => b.classList.toggle('active', b.dataset.lang === lang));
    downloadLink.href = file;
    setStatus(loadingText);
    viewer.replaceChildren();
    try {
      if (loadingTask) await loadingTask.destroy();
      const response = await fetch(file, { cache: 'no-store' });
      if (!response.ok) throw new Error(`PDF request failed (${response.status})`);
      const data = new Uint8Array(await response.arrayBuffer());
      loadingTask = pdfjsLib.getDocument({ data });
      pdfDoc = await loadingTask.promise;
      setStatus('');
      zoom = 1;
      await renderAll();
    } catch (error) {
      pdfDoc = null;
      console.error('Could not open resume PDF:', error);
      setStatus(errorText);
    }
  }

  langButtons.forEach((b) =>
    b.addEventListener('click', () => load(b.dataset.file!, b.dataset.lang!))
  );

  document.getElementById('zoom-in')!.addEventListener('click', () => {
    zoom = Math.min(MAX_ZOOM, +(zoom + STEP).toFixed(2));
    scheduleRender();
  });
  document.getElementById('zoom-out')!.addEventListener('click', () => {
    zoom = Math.max(MIN_ZOOM, +(zoom - STEP).toFixed(2));
    scheduleRender();
  });
  document.getElementById('zoom-fit')!.addEventListener('click', () => {
    zoom = 1;
    scheduleRender();
  });

  window.addEventListener('resize', () => {
    if (viewer.clientWidth !== lastWidth) scheduleRender();
  });

  const requestedLang = new URLSearchParams(window.location.search).get('lang');
  const htmlLang = requestedLang === 'fr' || requestedLang === 'ar'
    ? requestedLang
    : document.documentElement.lang.slice(0, 2).toLowerCase();
  document.documentElement.lang = htmlLang;
  document.documentElement.dir = htmlLang === 'ar' ? 'rtl' : 'ltr';
  const start = langButtons.find((b) => b.dataset.lang === (requestedLang ?? defaultLang)) ?? langButtons[0];
  load(start.dataset.file!, start.dataset.lang!);
</script>

<style>
  .resume {
    max-width: 900px;
    margin: 0 auto;
    padding: 1rem;
  }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .group {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .toolbar button,
  .download {
    min-width: 2.5rem;
    min-height: 2.5rem;
    padding: 0 0.8rem;
    border: 1px solid rgba(128, 128, 128, 0.5);
    border-radius: 8px;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .toolbar button:focus-visible,
  .download:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  .lang.active {
    background: rgba(128, 128, 128, 0.25);
    font-weight: 600;
  }
  #zoom-label {
    min-width: 3.5rem;
    text-align: center;
  }
  #status {
    text-align: center;
    margin: 1rem 0;
  }
  .viewer {
    overflow: auto;
    border: 1px solid rgba(128, 128, 128, 0.4);
    border-radius: 8px;
    background: rgba(128, 128, 128, 0.12);
    direction: ltr;
  }
  .viewer :global(canvas) {
    display: block;
    max-width: none;
    margin: 0 auto 12px;
    background: #fff;
    direction: ltr;
  }
</style>
