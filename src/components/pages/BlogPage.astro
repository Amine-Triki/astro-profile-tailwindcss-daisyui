---
import Layout from "../../layouts/Layout.astro";
import Card from "../card.astro";
import { type Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";
const { lang } = Astro.props as { lang: Lang }; const t = useTranslations(lang);
---
<Layout lang={lang} title={t("blog.metaTitle")} description={t("blog.metaDescription")}><div class="container mx-auto py-10"><h1 class="sr-only">{t("nav.blog")}</h1>{lang !== "en" && <p class="mb-6 rounded-box bg-base-200 p-4 text-sm">{t("blog.fallback")}</p>}<Card lang={lang} /></div></Layout>
