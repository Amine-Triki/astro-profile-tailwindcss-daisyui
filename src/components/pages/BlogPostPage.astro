---
import Layout from "../../layouts/Layout.astro";
import data from "../../data";
import { type Lang } from "../../i18n/ui";
import { localizedUrl, useTranslations } from "../../i18n/utils";
const { lang, slug } = Astro.props as { lang: Lang; slug: string };
const t = useTranslations(lang);
const post = data.find((item) => item.slug === slug);
if (!post) throw new Error(`Blog post not found: ${slug}`);
const videoId = post.videoUrl.match(/[?&]v=([^&]+)/)?.[1];
---
<Layout lang={lang} title={`${post.title} | Amine Triki`} description={post.description}><article class="container mx-auto max-w-4xl px-4 py-16"><header class="mb-8"><h1 class="mb-4 text-4xl font-bold md:text-5xl">{post.title}</h1>{post.description && <p class="text-xl text-base-content/70">{post.description}</p>}</header>{videoId && <div class="mb-8 aspect-video"><iframe class="h-full w-full rounded-lg" src={`https://www.youtube.com/embed/${videoId}`} title={post.title} allowfullscreen /></div>}<div class="prose prose-lg max-w-none" set:html={post.content ?? ""}></div><a href={localizedUrl(lang, "blog")} class="btn btn-outline mt-12">← {t("blog.back")}</a></article></Layout>
