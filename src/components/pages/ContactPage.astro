---
import Layout from "../../layouts/Layout.astro";
import Icons from "../Icons.astro";
import { displayNames, type Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";
const { lang } = Astro.props as { lang: Lang }; const t = useTranslations(lang);
const displayName = displayNames[lang];
const messages = { security: t("contact.security"), sending: t("contact.sending"), sent: t("contact.sent"), success: t("contact.success"), error: t("contact.error") };
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "0x4AAAAAAFdqCEhSdAJ4px3t";
const projectTypes = [["landing", "contact.project.type.landing"], ["business", "contact.project.type.business"], ["ecommerce", "contact.project.type.ecommerce"], ["webapp", "contact.project.type.webapp"], ["mobile", "contact.project.type.mobile"], ["unsure", "contact.project.type.unsure"], ["other", "contact.project.type.other"]] as const;
const features = [["contact-form", "contact.project.feature.contactForm"], ["languages", "contact.project.feature.languages"], ["blog", "contact.project.feature.blog"], ["gallery", "contact.project.feature.gallery"], ["search", "contact.project.feature.search"], ["catalog", "contact.project.feature.catalog"], ["payment", "contact.project.feature.payment"], ["delivery", "contact.project.feature.delivery"], ["reviews", "contact.project.feature.reviews"], ["accounts", "contact.project.feature.accounts"], ["roles", "contact.project.feature.roles"], ["admin", "contact.project.feature.admin"], ["booking", "contact.project.feature.booking"], ["reports", "contact.project.feature.reports"], ["import-export", "contact.project.feature.importExport"], ["notifications", "contact.project.feature.notifications"], ["chat", "contact.project.feature.chat"], ["maps", "contact.project.feature.maps"]] as const;
const languages = [["ar", "contact.project.language.arabic"], ["fr", "contact.project.language.french"], ["en", "contact.project.language.english"]] as const;
const contentOptions = [["ready", "contact.project.content.ready"], ["part", "contact.project.content.part"], ["help", "contact.project.content.help"]] as const;
const hostingOptions = [["both", "contact.project.hosting.both"], ["domain", "contact.project.hosting.domain"], ["neither", "contact.project.hosting.neither"]] as const;
const budgetOptions = [["under-800", "contact.project.budget.under800"], ["800-1500", "contact.project.budget.800to1500"], ["1500-3000", "contact.project.budget.1500to3000"], ["3000-6000", "contact.project.budget.3000to6000"], ["over-6000", "contact.project.budget.over6000"], ["unsure", "contact.project.budget.unsure"]] as const;
const timelineOptions = [["asap", "contact.project.timeline.asap"], ["month", "contact.project.timeline.month"], ["three-months", "contact.project.timeline.threeMonths"], ["none", "contact.project.timeline.none"]] as const;
---
<Layout lang={lang} title={`${t("contact.title")} | ${displayName}`} description={t("meta.contact")}><section class="min-h-screen bg-base-200 px-4 py-16"><div class="container mx-auto max-w-6xl"><div class="mb-12 text-center"><h1 class="mb-4 text-5xl font-bold text-error">{t("contact.title")}</h1><p class="text-xl text-base-content/70">{t("contact.subtitle")}</p></div><div class="grid gap-8 lg:grid-cols-2"><div class="space-y-8"><h2 class="text-3xl font-bold">{t("contact.subtitle")}</h2><p class="text-lg leading-relaxed text-base-content/80">{t("contact.intro")}</p><div class="space-y-4"><p><strong>{t("contact.name")}:</strong> {displayName}</p><p><strong>{t("contact.address")}:</strong> Sfax, Tunisia</p><p><strong>{t("contact.email")}:</strong> <a href="mailto:amine.triki@live.com" class="link">amine.triki@live.com</a></p>{t("contact.social")}<Icons only={["Facebook", "LinkedIn"]} /></div></div>
  <form id="contactForm" action="/api/contact" method="post" class="space-y-4">
    <div class="grid gap-4 sm:grid-cols-2">{([["firstName","contact.first","contact.firstPlaceholder"],["lastName","contact.last","contact.lastPlaceholder"]] as const).map(([name,label,placeholder]) => <div class="form-control"><label class="label"><span class="label-text font-medium">{t(label)}</span></label><input type="text" name={name} placeholder={t(placeholder)} class="input input-bordered w-full" required /></div>)}</div>
    <label class="label"><span class="label-text font-medium">{t("contact.email")}</span></label><input type="email" name="email" placeholder={t("contact.emailPlaceholder")} class="input input-bordered w-full" required />
    <label class="label"><span class="label-text font-medium">{t("contact.subject")}</span></label><input type="text" name="subject" placeholder={t("contact.subjectPlaceholder")} class="input input-bordered w-full" required />
    <label class="label"><span class="label-text font-medium">{t("contact.message")}</span></label><textarea name="message" class="textarea textarea-bordered h-32 w-full resize-none" placeholder={t("contact.messagePlaceholder")} required></textarea>
    <details id="project-form" class="rounded-box border border-base-300 bg-base-100 p-4">
      <summary class="cursor-pointer font-medium">{t("contact.project.summary")}</summary>
      <div class="mt-4 space-y-4">
        <label class="form-control gap-2"><span class="label-text font-medium">{t("contact.project.type.label")}</span><select name="projectType" class="select select-bordered w-full"><option value="">{t("contact.project.choose")}</option>{projectTypes.map(([value, key]) => <option value={value}>{t(key)}</option>)}</select></label>
        <label class="form-control gap-2"><span class="label-text font-medium">{t("contact.project.goal.label")}</span><textarea name="projectGoal" maxlength="600" class="textarea textarea-bordered w-full resize-none" placeholder={t("contact.project.goal.placeholder")}></textarea></label>
        <fieldset><legend class="label-text font-medium">{t("contact.project.features.label")}</legend><div class="mt-2 grid gap-2 sm:grid-cols-2">{features.map(([value, key]) => <label class="flex items-center gap-2"><input type="checkbox" name="features" value={value} class="checkbox checkbox-sm" /> <span>{t(key)}</span></label>)}</div><input type="text" name="otherFeatures" maxlength="200" class="input input-bordered mt-3 w-full" placeholder={t("contact.project.otherFeatures.placeholder")} /></fieldset>
        <fieldset><legend class="label-text font-medium">{t("contact.project.languages.label")}</legend><div class="mt-2 flex flex-wrap gap-4">{languages.map(([value, key]) => <label class="flex items-center gap-2"><input type="checkbox" name="languages" value={value} class="checkbox checkbox-sm" /> <span>{t(key)}</span></label>)}</div></fieldset>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="form-control gap-2"><span class="label-text font-medium">{t("contact.project.content.label")}</span><select name="content" class="select select-bordered w-full"><option value="">{t("contact.project.choose")}</option>{contentOptions.map(([value, key]) => <option value={value}>{t(key)}</option>)}</select></label>
          <label class="form-control gap-2"><span class="label-text font-medium">{t("contact.project.hosting.label")}</span><select name="hosting" class="select select-bordered w-full"><option value="">{t("contact.project.choose")}</option>{hostingOptions.map(([value, key]) => <option value={value}>{t(key)}</option>)}</select></label>
          <label class="form-control gap-2"><span class="label-text font-medium">{t("contact.project.budget.label")}</span><select name="budget" class="select select-bordered w-full"><option value="">{t("contact.project.choose")}</option>{budgetOptions.map(([value, key]) => <option value={value}>{t(key)}</option>)}</select></label>
          <label class="form-control gap-2"><span class="label-text font-medium">{t("contact.project.timeline.label")}</span><select name="timeline" class="select select-bordered w-full"><option value="">{t("contact.project.choose")}</option>{timelineOptions.map(([value, key]) => <option value={value}>{t(key)}</option>)}</select></label>
        </div>
        <label class="form-control gap-2"><span class="label-text font-medium">{t("contact.project.examples.label")}</span><input type="text" name="examples" maxlength="300" class="input input-bordered w-full" placeholder={t("contact.project.examples.placeholder")} /></label>
      </div>
    </details>
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" /><div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto"></div><p id="contactStatus" class="min-h-6 text-sm" role="status"></p><button type="submit" class="btn btn-wide bg-amber-950 text-white">{t("contact.send")}</button>
  </form></div></div></section></Layout>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script define:vars={{ messages }}>
  document.getElementById("contactForm")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;
    const button = form.querySelector("button");
    if (!(button instanceof HTMLButtonElement)) return;
    const status = document.getElementById("contactStatus");
    const token = form.elements.namedItem("cf-turnstile-response");
    if (!(token instanceof HTMLInputElement) || !token.value) {
      if (status) {
        status.textContent = messages.security;
        status.className = "min-h-6 text-sm text-error";
      }
      return;
    }
    const original = button.innerHTML;
    button.innerHTML = `<span class="loading loading-spinner loading-sm"></span> ${messages.sending}`;
    button.disabled = true;
    try {
      const response = await fetch("/api/contact", { method: "POST", body: new FormData(form) });
      const result = await response.json();
      if (!response.ok || !result.ok) throw new Error(result.error || messages.error);
      button.textContent = messages.sent;
      if (status) {
        status.textContent = messages.success;
        status.className = "min-h-6 text-sm text-success";
      }
      form.reset();
    } catch (error) {
      button.innerHTML = original;
      if (status) {
        status.textContent = error instanceof Error ? error.message : messages.error;
        status.className = "min-h-6 text-sm text-error";
      }
    } finally {
      setTimeout(() => {
        button.disabled = false;
        button.innerHTML = original;
        window.turnstile?.reset();
      }, 2000);
    }
  });
</script>
<script is:inline>
  const projectForm = document.getElementById("project-form");
  if (projectForm instanceof HTMLDetailsElement && window.location.hash === "#project-form") {
    projectForm.open = true;
  }
</script>
