---
import Layout from "../../layouts/Layout.astro";
import { type Lang } from "../../i18n/ui";
import { localizedUrl, useTranslations } from "../../i18n/utils";
const { lang } = Astro.props as { lang: Lang }; const t = useTranslations(lang);
const services = [["services.web.title","services.web.description"],["services.landing.title","services.landing.description"],["services.shop.title","services.shop.description"],["services.app.title","services.app.description"],["services.mobile.title","services.mobile.description"],["services.custom.title","services.custom.description"]] as const;
const process = { revisionRounds: 2 };
const pricing = {
  lastUpdated: "2026",
  items: [
    { key: "landing", from: 500 },
    { key: "business", from: 900 },
    { key: "ecommerce", from: 2500 },
    { key: "webapp", from: 5000 },
    { key: "mobile", from: 800 },
    { key: "custom", from: null },
  ],
} as const;
const pricingLabelKeys = {
  landing: "pricing.landing",
  business: "pricing.business",
  ecommerce: "pricing.ecommerce",
  webapp: "pricing.webapp",
  mobile: "pricing.mobile",
  custom: "pricing.custom",
} as const;
const formatPrice = (value: number) =>
  new Intl.NumberFormat("en-US").format(value).replace(/,/g, lang === "fr" ? "\u00a0" : ",");
---
<Layout lang={lang} title={`${t("services.label")} | Amine Triki`} description={t("meta.services")}><main>
  <section class="bg-base-200 px-4 py-20 md:py-28"><div class="container mx-auto max-w-6xl"><p class="mb-4 font-semibold uppercase tracking-[0.2em] text-primary">{t("services.label")}</p><h1 class="text-4xl font-bold leading-tight md:text-6xl">{t("services.hero")}</h1><p class="mt-6 max-w-2xl text-lg leading-relaxed text-base-content/70">{t("services.intro")}</p><div class="mt-8 flex flex-wrap gap-4"><a href={`/${lang === "en" ? "" : `${lang}/`}contact`} class="btn btn-primary">{t("services.talk")}</a><a href={`/${lang === "en" ? "" : `${lang}/`}projects`} class="btn btn-outline">{t("services.viewProjects")}</a></div></div></section>
  <section class="px-4 py-20"><div class="container mx-auto max-w-6xl"><p class="mb-3 font-semibold uppercase tracking-[0.2em] text-primary">{t("services.offer")}</p><h2 class="text-3xl font-bold md:text-4xl">{t("services.built")}</h2><div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">{services.map(([title, description], i) => <article class="card border border-base-300 bg-base-100 shadow-sm"><div class="card-body"><span class="text-sm font-semibold text-primary">0{i + 1}</span><h3 class="card-title text-2xl">{t(title)}</h3><p class="leading-relaxed text-base-content/70">{t(description)}</p></div></article>)}</div></div></section>
  <section class="px-4 py-16"><div class="container mx-auto max-w-6xl"><p class="mb-3 font-semibold uppercase tracking-[0.2em] text-primary">{t("pricing.label")}</p><h2 class="text-3xl font-bold md:text-4xl">{t("pricing.heading")}</h2><p class="mt-4 max-w-2xl leading-relaxed text-base-content/70">{t("pricing.intro")}</p><dl class="mt-8 max-w-3xl border-y border-base-300">{pricing.items.map((item) => <div class="flex flex-col gap-2 border-b border-base-300 py-4 last:border-b-0 sm:flex-row sm:items-center sm:justify-between sm:gap-6"><dt class="font-medium">{t(pricingLabelKeys[item.key])}</dt><dd class="whitespace-nowrap font-semibold text-primary">{item.from === null ? t("pricing.onRequest") : <>{t("pricing.from")} <bdi dir="ltr">{formatPrice(item.from)} {t("pricing.currency")}</bdi></>}</dd></div>)}</dl><p class="mt-6 max-w-3xl text-sm leading-relaxed text-base-content/60">{t("pricing.note")}</p><p class="mt-2 text-xs text-base-content/50">{t("pricing.lastUpdated")} {pricing.lastUpdated}</p></div></section>
  <section class="px-4 py-16"><div class="container mx-auto max-w-6xl"><p class="mb-3 font-semibold uppercase tracking-[0.2em] text-primary">{t("process.label")}</p><h2 class="text-3xl font-bold md:text-4xl">{t("process.heading")}</h2><ol class="mt-8 max-w-3xl divide-y divide-base-300 border-y border-base-300">{(["discuss", "quote", "start", "build", "delivery"] as const).map((step, i) => <li class="flex gap-4 py-5 first:pt-4 last:pb-4"><span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-primary font-semibold text-primary">{i + 1}</span><div><h3 class="font-semibold">{t(`process.${step}.title`)}</h3><p class="mt-1 leading-relaxed text-base-content/70">{step === "discuss" ? <>{t("process.discuss.before")} <a href={localizedUrl(lang, "/contact/#project-form")} class="link link-primary">{t("process.discuss.link")}</a> {t("process.discuss.after")}</> : t(`process.${step}.description`).replace("{n}", String(process.revisionRounds))}</p></div></li>)}</ol><p class="mt-6 max-w-3xl text-sm leading-relaxed text-base-content/60">{t("process.note")}</p></div></section>
  <section class="bg-primary px-4 py-20 text-primary-content"><div class="container mx-auto flex max-w-6xl flex-col items-start justify-between gap-8 md:flex-row md:items-center"><div><h2 class="text-3xl font-bold md:text-4xl">{t("services.projectMind")}</h2><p class="mt-4 text-lg text-primary-content/80">{t("services.projectCta")}</p></div><a href={`/${lang === "en" ? "" : `${lang}/`}contact`} class="btn bg-base-100 text-base-content">{t("services.talk")}</a></div></section>
</main></Layout>
