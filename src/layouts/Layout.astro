---
import "../styles/global.css";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="google-site-verification"
      content="6Uv5yhzQFcfkKSPsifCwqEgyqPTqD_ebAozgsZ7ELig"
    />
    <meta name="viewport" content="width=device-width" />
    <!-- PWA Meta Tags -->
    <meta name="theme-color" content="#ffffff" />
    <link rel="apple-touch-icon" href="/icon-192x192.png" />
    <link rel="manifest" href="/manifest.json" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content=" I’m a Full Stack Developer and creative content creator. I turn ideas into websites that are fast, modern, and very easy to use — helping businesses grow online. Whether you need a custom web application or a WordPress site, I focus on clean design and ensure everything works perfectly on phones, tablets, and computers (Responsive Design). Beyond coding"
    />
    <title>Amine Triki</title>
  </head>
  <body>
    <Navbar />
    <div class="grow min-h-screen">
      <slot />
    </div>
    <Footer />
    <!-- Register Service Worker -->
    <!-- Register Service Worker -->
    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          // حذف Service Workers القديمة
          navigator.serviceWorker.getRegistrations().then((registrations) => {
            registrations.forEach((reg) => reg.unregister());
          });

          // مسح الـ cache القديم
          caches.keys().then((names) => {
            names.forEach((name) => caches.delete(name));
          });

          // تسجيل Service Worker الجديد
          setTimeout(() => {
            navigator.serviceWorker
              .register("/sw.js")
              .then((reg) => {
                console.log("✅ SW registered");
                reg.update(); // تحديث فوري
              })
              .catch((err) => console.log("❌ SW failed:", err));
          }, 100);
        });
      }
    </script>
  </body>
</html>

<style></style>
