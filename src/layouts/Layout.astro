---
import "../styles/global.css";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "@fontsource-variable/cairo";
import { defaultLang, type Lang } from "../i18n/ui";
import { getLangFromUrl } from "../i18n/utils";

const {
  title = "Amine Triki",
  description = "",
  robots = "index, follow",
  localized = true,
  lang = getLangFromUrl(Astro.url) as Lang,
} = Astro.props;
const {
  canonical = new URL(Astro.url.pathname, "https://amine-triki.tn").href,
  image = new URL("/icon-512x512.png", "https://amine-triki.tn").href,
  type = "website",
  structuredData,
} = Astro.props;
---

<!doctype html>
<html lang={lang || defaultLang} dir={lang === "ar" ? "rtl" : "ltr"}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="google-site-verification"
      content="6Uv5yhzQFcfkKSPsifCwqEgyqPTqD_ebAozgsZ7ELig"
    />
    <meta name="viewport" content="width=device-width" />
    <!-- PWA Meta Tags -->
    <meta name="theme-color" content="#ffffff" />
    <link rel="apple-touch-icon" href="/icon-192x192.png" />
    <link rel="manifest" href="/manifest.json" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content={description}
    />
    <meta name="robots" content={robots} />
    <slot name="head" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Amine Triki" />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : lang === "ar" ? "ar_TN" : "en_US"} />
    {(["en", "fr", "ar"] as const).filter((locale) => locale !== lang).map((locale) => (
      <meta property="og:locale:alternate" content={locale === "fr" ? "fr_FR" : locale === "ar" ? "ar_TN" : "en_US"} />
    ))}
    {localized && (["en", "fr", "ar"] as const).map((locale) => (
      <link rel="alternate" hreflang={locale} href={new URL(locale === "en" ? Astro.url.pathname.replace(/^\/(fr|ar)/, "") : `/${locale}${Astro.url.pathname.replace(/^\/(fr|ar)/, "")}`, "https://amine-triki.tn").href} />
    ))}
    {localized && <link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname.replace(/^\/(fr|ar)/, ""), "https://amine-triki.tn").href} />}
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
    <title>{title}</title>
  </head>
  <body>
    <Navbar showLanguageSwitcher={localized} />
    <div class="grow min-h-screen">
      <slot />
    </div>
    <Footer />
    <!-- Register Service Worker -->
    <!-- Register Service Worker -->
    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          // حذف Service Workers القديمة
          navigator.serviceWorker.getRegistrations().then((registrations) => {
            registrations.forEach((reg) => reg.unregister());
          });

          // مسح الـ cache القديم
          caches.keys().then((names) => {
            names.forEach((name) => caches.delete(name));
          });

          // تسجيل Service Worker الجديد
          setTimeout(() => {
            navigator.serviceWorker
              .register("/sw.js")
              .then((reg) => {
                console.log("✅ SW registered");
                reg.update(); // تحديث فوري
              })
              .catch((err) => console.log("❌ SW failed:", err));
          }, 100);
        });
      }
    </script>
  </body>
</html>

<style></style>
