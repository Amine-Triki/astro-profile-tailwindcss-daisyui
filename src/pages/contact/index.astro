---
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <style>
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .fade-in {
      animation: fadeIn 0.6s ease-out forwards;
    }

    .delay-1 {
      animation-delay: 0.1s;
      opacity: 0;
    }
    .delay-2 {
      animation-delay: 0.2s;
      opacity: 0;
    }
  </style>

  <section id="Contact" class="min-h-screen py-16 px-4 bg-base-200">
    <div class="container mx-auto max-w-6xl">
      <!-- Title -->
      <div class="text-center mb-12 fade-in">
        <h2 class="text-5xl md:text-6xl font-bold mb-4 text-error">
          Contact Me
        </h2>
        <p class="text-xl text-base-content/70">Get in touch</p>
      </div>

      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12">
        <!-- Left Info -->
        <div class="space-y-8 fade-in delay-1">
          <div>
            <h3 class="text-3xl font-bold mb-4">Get in touch</h3>
            <p class="text-lg text-base-content/80 leading-relaxed">
              If you have any questions or proposals, you can simply write
              to us.<br />
              We will answer you as soon as possible.
            </p>
          </div>

          <!-- Contact Info -->
          <div class="space-y-4">
            <!-- Name -->
            <div class="flex items-start gap-3">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-4 min-w-4 min-h-4 shrink-0 mt-1 text-error"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                ></path>
              </svg>
              <div class="text-base-content">
                <span class="font-bold">Name :</span> Amine Triki
              </div>
            </div>

            <!-- Address -->
            <div class="flex items-start gap-3">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-4 min-w-4 min-h-4 shrink-0 mt-1 text-error"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"
                ></path>
              </svg>
              <div class="text-base-content">
                <span class="font-bold">Address :</span> Sakiet Ezzit, Sfax,
                Tunisia
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-3">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-4 min-w-4 min-h-4 shrink-0 mt-1 text-error"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
                ></path>
              </svg>
              <div class="text-base-content break-all">
                <span class="font-bold">Email :</span> amine.triki@live.com
              </div>
            </div>
          </div>
        </div>

        <!-- Form -->
        <div class="fade-in delay-2">
          <form id="contactForm" class="space-y-4">
            <div class="grid sm:grid-cols-2 gap-4">
              <div class="form-control">
                <label class="label">
                  <span class="label-text font-medium">First name</span>
                </label>
                <input
                  type="text"
                  placeholder="first name"
                  class="input input-bordered w-full"
                  required
                />
              </div>

              <div class="form-control">
                <label class="label">
                  <span class="label-text font-medium">Last name</span>
                </label>
                <input
                  type="text"
                  placeholder="last name"
                  class="input input-bordered w-full"
                  required
                />
              </div>
            </div>

            <div class="form-control">
              <label class="label">
                <span class="label-text font-medium">Email address</span>
              </label>
              <input
                type="email"
                placeholder="example@example.com"
                class="input input-bordered w-full"
                required
              />
            </div>

            <div class="form-control">
              <label class="label">
                <span class="label-text font-medium">Subject</span>
              </label>
              <input
                type="text"
                placeholder="How can we help you?"
                class="input input-bordered w-full"
                required
              />
            </div>

            <div class="form-control">
              <label class="label">
                <span class="label-text font-medium">Message</span>
              </label>
              <textarea
                class="textarea textarea-bordered w-full h-32 resize-none"
                placeholder="Write your message here..."
                required></textarea>
            </div>

            <button
              type="submit"
              class="btn btn-wide bg-amber-950 hover:bg-amber-900 text-white border-none"
            >
              Send
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <script>
    document
      .getElementById("contactForm")
      ?.addEventListener("submit", function (e) {
        e.preventDefault();

        const form = e.target as HTMLFormElement;
        const btn = form.querySelector(
          'button[type="submit"]'
        ) as HTMLButtonElement;

        if (!btn) return;

        const originalText = btn.innerHTML;

        btn.innerHTML =
          '<span class="loading loading-spinner loading-sm"></span> Sending...';
        btn.disabled = true;

        setTimeout(() => {
          btn.innerHTML = "✓ Sent Successfully!";
          btn.classList.remove("bg-amber-950", "hover:bg-amber-900");
          btn.classList.add("btn-success");

          setTimeout(() => {
            btn.innerHTML = originalText;
            btn.disabled = false;
            btn.classList.remove("btn-success");
            btn.classList.add("bg-amber-950", "hover:bg-amber-900");
            form.reset();
          }, 2000);
        }, 1500);
      });
  </script>
</Layout>